        {
          "action": "tap",
          "label": "Done",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Done"
        },
        {
          "action": "type_text",
          "label": "New password ",
          "tag": "XCUIElementTypeOther",
          "strategy": "accessibility id",
          "value": "New password ",
          "text": "Qwerty@123"
        },
        {
          "action": "tap",
          "label": "Done",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Done"
        },
        {
          "action": "type_text",
          "label": "XCUIElementTypeSecureTextField",
          "tag": "XCUIElementTypeSecureTextField",
          "strategy": "xpath",
          "value": "(//XCUIElementTypeSecureTextField)[3]",
          "text": "Qwerty@123"
        },
        {
          "action": "tap",
          "label": "Done",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Done"
        },
        {
          "action": "tap",
          "label": "Submit",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Submit"
        },
        {
          "action": "assert_visible",
          "label": "is incorrect",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "is incorrect"
        }
      ]
    },
