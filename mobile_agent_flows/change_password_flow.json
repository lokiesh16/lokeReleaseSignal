  "appium": {
    "platform": "iOS",
    "device": "Lokesh's iPhone",
    "bundle_id": "habitnu2.stag",
    "platform_version": "18.6.2",
    "extra_caps": {
      "appium:wdaLocalPort": 8100,
      "appium:useNewWDA": false,
      "appium:connectHardwareKeyboard": true,
      "appium:settings[snapshotMaxDepth]": 70
    }
  },
  "tests": [
    {
      "description": "Validate user can change their password",
      "steps": [
        {
          "action": "tap",
          "label": "Go to profile",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Go to profile",
          "description": "Validate Change password option is displayed in Profile page"
        },
        {
          "action": "tap",
          "label": "Change Password",
          "tag": "XCUIElementTypeOther",
          "strategy": "accessibility id",
          "value": "Change Password"
        }
      ]
    },
    {
      "description": "Validate clicking 'Change Password' takes to 'Create New Password' page",
      "steps": [
        {
          "action": "assert_visible",
          "label": "Create New Password",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "Create New Password",
          "description": "Validate clicking 'Change Password' takes to 'Create New Password' page"
        }
      ]
    },
    {
      "description": "Validate Create New Password page elements",
      "steps": [
        {
          "action": "assert_visible",
          "label": "Enter your new password to reset.",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "Enter your new password to reset.",
          "description": "Validate Create New Password page elements"
        },
        {
          "action": "assert_visible",
          "label": "Current password ",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "Current password "
        },
        {
          "action": "assert_visible",
          "label": "New password ",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "New password "
        },
        {
          "action": "assert_visible",
          "label": "Must contain a letter, a number and a symbol (e.g. hyphen or underscore). It must be at least 8 characters long.",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "Must contain a letter, a number and a symbol (e.g. hyphen or underscore). It must be at least 8 characters long."
        },
        {
          "action": "assert_visible",
          "label": "Confirm New password ",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "Confirm New password "
        }
      ]
    },
    {
      "description": "Validate clicking 'Submit' throws 'is required' message when nothing required fields are filled",
      "steps": [
        {
          "action": "tap",
          "label": "Submit",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Submit",
          "description": "Validate clicking 'Submit' throws 'is required' message when nothing required fields are filled"
        },
        {
          "action": "assert_visible",
          "label": "is required",
          "tag": "XCUIElementTypeStaticText",
          "strategy": "accessibility id",
          "value": "is required"
        },
        {
          "action": "assert_visible",
          "label": "Confirm your new password is required",
          "tag": "XCUIElementTypeOther",
          "strategy": "accessibility id",
          "value": "Confirm your new password is required"
        }
      ]
    },
    {
      "description": "Validate 'Is incorrect' error message is displayed while trying to submit with incorrect 'Current password'",
      "steps": [
        {
          "action": "tap",
          "label": "Profile, back",
          "tag": "XCUIElementTypeButton",
          "strategy": "accessibility id",
          "value": "Profile, back",
          "description": "Validate 'Is incorrect' error message is displayed while trying to submit with incorrect 'Current password'"
