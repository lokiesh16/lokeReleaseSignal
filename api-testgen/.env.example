# Copy this file to ".env" (same folder as server.py) and fill in real
# values. ".env" is gitignored - never commit it. Both a source run
# (`python server.py`) and a frozen build load it automatically.

# The Script Runner's one external pytest project - an already-real,
# Allure-instrumented API test suite (unrelated to this tool's own
# network-capture/generation pipeline). Its own venv is auto-detected the
# same way Suite Runner's _venv_python() already does (venv/bin/python
# etc. under this root).
TESTLOKE_PROJECT_ROOT=

# Publishes a Script Runner run's Allure report to a Cloudflare R2 bucket
# (see cf_r2.py) - same mechanism mobile_agent's own cf_r2.py uses for its
# Test Scripts tab. Needs the `allure` CLI on PATH (e.g. brew install
# allure) and the bucket's "Public Access" enabled in the R2 dashboard, or
# uploads succeed but the returned URL 403s.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_PUBLIC_URL=

# Publishes a UI replay report to the team S3 bucket, listed on the Test cases page under
# "web test run results". Uses this machine's AWS credentials: AWS_PROFILE (after `aws sso login`)
# or AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY. They need s3:GetObject + s3:PutObject on
# "web test run results/*" in the bucket.
S3_REPORTS_BUCKET=habitnu-test-case-reports
S3_REPORTS_REGION=us-east-1
S3_REPORTS_VIEWER_URL=https://d22dd347kzhnw7.cloudfront.net
# AWS_PROFILE=habitnu
# S3_REPORTS_PUBLISHER=your.name@habitnu.com

# Optional overrides - omit to use the defaults already in server.py.
# TARGET_URL=https://example.com
# OLLAMA_URL=http://localhost:11434
# PORT=5002

# Optional: MiniMax (or any model) through OpenRouter. With the key set here you don't
# have to paste it into the UI each time. OPENROUTER_MODEL changes the default model.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=minimax/minimax-m3

# "Run script" steps (the Scripts card) - DB scripts and API scripts. The app runs them on its own built-in Python, so the .env file
# next to the app is all a teammate needs. Scripts read these through db / env("NAME"); never write secrets inside a script.
# The MongoDB the DB scripts talk to. The app refuses a URI or database name that contains "prod".
MONGO_URI=          # MONGODB_URI works too
DB_NAME=
# For API scripts: put whatever they read with env("NAME") here, e.g.
# API_BASE_URL=
# API_TOKEN=
# Optional: run scripts with a specific Python instead of the built-in one (only needed for pytest-style script files).
# SCRIPTS_PYTHON=
